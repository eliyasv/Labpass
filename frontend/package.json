{
  "name": "labpass-frontend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "generate": "openapi-typescript openapi.json -o src/generated/api.ts",
    "check-contract": "node scripts/check-contract.mjs",
    "format": "prettier --write src tests scripts *.ts *.json index.html nginx.conf --ignore-unknown",
    "format:check": "prettier --check src tests scripts *.ts *.json index.html nginx.conf --ignore-unknown",
    "test": "playwright test",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
